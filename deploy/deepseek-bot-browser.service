[Unit]
Description=DeepSeek Bot dedicated persistent browser
After=network-online.target
Wants=network-online.target

[Service]
User=deepseek-bot
Group=deepseek-bot
Environment=HOME=/var/lib/deepseek-bot
ExecStart=/usr/bin/google-chrome-stable --headless --disable-gpu --disable-dev-shm-usage --no-first-run --remote-debugging-address=127.0.0.1 --remote-debugging-port=9223 --user-data-dir=/var/lib/deepseek-bot/browser-profile about:blank
Restart=on-failure
RestartSec=4
PrivateTmp=true
UMask=0077
MemoryMax=640M
TasksMax=512

[Install]
WantedBy=multi-user.target
